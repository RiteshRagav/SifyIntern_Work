# ==================== LLM Config ====================
# Option A: Groq (FREE - recommended for dev/demo)
# Get key: https://console.groq.com/keys
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI Direct (paid, best quality)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Option C: Google Gemini (FREE - 1500 req/day)
# Get key: https://aistudio.google.com/apikey
# OPENAI_API_KEY=AIzaSy_your_gemini_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_EMBEDDING_MODEL=text-embedding-004

# ==================== Generation Settings ====================
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==================== MongoDB ====================
# Local dev:
MONGODB_URI=mongodb://localhost:27017
# Cloud (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=storyboard_db

# ==================== ChromaDB ====================
CHROMADB_PERSIST_DIR=./chroma_data
CHROMADB_RAG_COLLECTION=rag_documents
CHROMADB_TME_COLLECTION=tme_memories

# ==================== Agent Config ====================
PREACT_MAX_SCENES=10
REACT_MAX_ITERATIONS=8
REFLECT_REVISION_ROUNDS=2

# ==================== App ====================
DEBUG=false
APP_NAME=AgentFlow AI
APP_VERSION=1.0.0
